<Window x:Class="ClaudeUsageMonitor.Views.WidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ClaudeUsageMonitor.ViewModels"
        Title="Claude Usage Monitor"
        Width="300" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="False"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        FontFamily="Segoe UI, Yu Gothic UI">
    <Window.Resources>
        <Style x:Key="LimitBar" TargetType="ProgressBar" BasedOn="{StaticResource UsageBar}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Level}" Value="{x:Static vm:UsageLevel.Warning}">
                    <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="{x:Static vm:UsageLevel.Critical}">
                    <Setter Property="Foreground" Value="{DynamicResource CriticalBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="{x:Static vm:UsageLevel.Stale}">
                    <Setter Property="Foreground" Value="{DynamicResource StaleBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="LimitPercent" TargetType="TextBlock" BasedOn="{StaticResource PrimaryText}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Level}" Value="{x:Static vm:UsageLevel.Warning}">
                    <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="{x:Static vm:UsageLevel.Critical}">
                    <Setter Property="Foreground" Value="{DynamicResource CriticalBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="{x:Static vm:UsageLevel.Stale}">
                    <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 利用枠・メモリの1行（名称・%・バー・補足） -->
        <DataTemplate x:Key="LimitItemTemplate" DataType="{x:Type vm:LimitItemViewModel}">
            <StackPanel Margin="0,0,0,10">
                <Grid>
                    <TextBlock Text="{Binding Label}" Style="{StaticResource PrimaryText}" />
                    <TextBlock Text="{Binding PercentText}" Style="{StaticResource LimitPercent}" HorizontalAlignment="Right" />
                </Grid>
                <ProgressBar Style="{StaticResource LimitBar}" Value="{Binding Percent, Mode=OneWay}" Margin="0,6,0,4" />
                <TextBlock Text="{Binding ResetText}" ToolTip="{Binding ResetTooltip}" Style="{StaticResource SecondaryText}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="BarItemTemplate" DataType="{x:Type vm:BarItemViewModel}">
            <Grid Margin="0,2,0,3" ToolTip="{Binding Tooltip}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="{Binding Name}" Style="{StaticResource SecondaryText}" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="1" Text="{Binding ValueText}" Style="{StaticResource SecondaryText}" Margin="8,0,0,0" />
                <ProgressBar Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource UsageBar}" Height="3" Margin="0,2,0,0"
                             Maximum="1" Value="{Binding Ratio, Mode=OneWay}" Foreground="{DynamicResource AccentBrush}" />
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Border x:Name="RootBorder" CornerRadius="10" BorderThickness="1" Padding="14,8,10,12" Margin="6"
            Background="{DynamicResource WidgetBackgroundBrush}" BorderBrush="{DynamicResource WidgetBorderBrush}"
            MouseLeftButtonDown="OnRootMouseLeftButtonDown" MouseMove="OnRootMouseMove"
            MouseLeftButtonUp="OnRootMouseLeftButtonUp">
        <Border.Effect>
            <DropShadowEffect BlurRadius="10" ShadowDepth="1" Opacity="0.35" />
        </Border.Effect>
        <StackPanel>
            <!-- ヘッダー -->
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="7" Height="7" Fill="{DynamicResource AccentBrush}" Margin="0,0,7,0" />
                    <TextBlock Text="Claude Usage" Style="{StaticResource SecondaryText}" FontWeight="SemiBold" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource IconButton}" Content="&#xE72C;" ToolTip="今すぐ更新" Click="OnRefreshClick"
                            IsEnabled="{Binding IsRefreshing, Converter={x:Static vm:Converters.Not}}" />
                    <Button x:Name="DetailButton" Style="{StaticResource IconButton}" Content="&#xE70D;" ToolTip="詳細表示の切り替え" Click="OnToggleDetailClick" />
                    <Button Style="{StaticResource IconButton}" Content="&#xE713;" ToolTip="設定" Click="OnSettingsClick" />
                    <Button Style="{StaticResource IconButton}" Content="&#xE711;" ToolTip="ウィジェットを隠す（トレイから再表示）" Click="OnHideClick" />
                </StackPanel>
            </Grid>

            <!-- エラー -->
            <Border Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}"
                    Background="{DynamicResource ErrorBackgroundBrush}" CornerRadius="4" Padding="8,5" Margin="0,8,4,0">
                <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource SecondaryText}" Foreground="{DynamicResource PrimaryTextBrush}"
                           TextWrapping="Wrap" />
            </Border>
            <TextBlock Visibility="{Binding HasNotice, Converter={StaticResource BoolToVisibility}}" Text="{Binding NoticeMessage}"
                       Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,8,4,0" />

            <!-- ACCOUNT -->
            <StackPanel Visibility="{Binding ShowAccount, Converter={StaticResource BoolToVisibility}}" Margin="0,0,4,0">
                <TextBlock Text="ACCOUNT" Style="{StaticResource SectionHeader}" />
                <Grid ToolTip="{Binding AccountTooltip}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Email" Style="{StaticResource SecondaryText}" FontSize="13" />
                    <TextBlock Grid.Column="1" Text="{Binding Email}" Style="{StaticResource PrimaryText}"
                               HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" Margin="12,0,0,0" />
                </Grid>
            </StackPanel>

            <!-- USAGE -->
            <TextBlock Text="USAGE" Style="{StaticResource SectionHeader}" />
            <ItemsControl ItemsSource="{Binding Limits}" ItemTemplate="{StaticResource LimitItemTemplate}" Margin="0,0,4,0" />
            <TextBlock Visibility="{Binding HasRawText, Converter={StaticResource BoolToVisibility}}" Text="{Binding RawText}"
                       Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,0,4,8" />

            <!-- SYSTEM（設定で有効にした場合のみ） -->
            <StackPanel Visibility="{Binding HasSystemItems, Converter={StaticResource BoolToVisibility}}" Margin="0,0,4,0">
                <TextBlock Text="SYSTEM" Style="{StaticResource SectionHeader}" Margin="0,0,0,6" />
                <ItemsControl ItemsSource="{Binding SystemItems}" ItemTemplate="{StaticResource LimitItemTemplate}" />
            </StackPanel>

            <!-- 詳細モード -->
            <StackPanel Visibility="{Binding IsDetail, Converter={StaticResource BoolToVisibility}}" Margin="0,0,4,0">
                <StackPanel Visibility="{Binding HasLocalStats, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="LOCAL ACTIVITY" Style="{StaticResource SectionHeader}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="5時間ブロック" Style="{StaticResource SecondaryText}" Margin="0,0,12,3" />
                        <TextBlock Grid.Column="1" Text="{Binding BlockText}" Style="{StaticResource PrimaryText}" FontSize="12" HorizontalAlignment="Right" />
                        <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding BurnRateText}" Style="{StaticResource SecondaryText}"
                                   HorizontalAlignment="Right" Margin="0,0,0,6" />
                        <TextBlock Grid.Row="2" Text="今日" Style="{StaticResource SecondaryText}" Margin="0,0,12,3" ToolTip="{Binding TodayBreakdown}" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding TodayText}" Style="{StaticResource PrimaryText}" FontSize="12"
                                   HorizontalAlignment="Right" ToolTip="{Binding TodayBreakdown}" />
                        <TextBlock Grid.Row="3" Text="今週" Style="{StaticResource SecondaryText}" Margin="0,0,12,3" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding WeekText}" Style="{StaticResource PrimaryText}" FontSize="12" HorizontalAlignment="Right" />
                        <TextBlock Grid.Row="4" Text="今月" Style="{StaticResource SecondaryText}" Margin="0,0,12,3" />
                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding MonthText}" Style="{StaticResource PrimaryText}" FontSize="12" HorizontalAlignment="Right" />
                    </Grid>

                    <TextBlock Text="MODELS（今週）" Style="{StaticResource SectionHeader}" />
                    <ItemsControl ItemsSource="{Binding Models}" ItemTemplate="{StaticResource BarItemTemplate}" />

                    <TextBlock Text="PROJECTS（今週・上位5件）" Style="{StaticResource SectionHeader}" />
                    <ItemsControl ItemsSource="{Binding Projects}" ItemTemplate="{StaticResource BarItemTemplate}" />
                </StackPanel>

                <StackPanel Visibility="{Binding HasInsights, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="INSIGHTS" Style="{StaticResource SectionHeader}" />
                    <TextBlock Text="{Binding Insights}" Style="{StaticResource SecondaryText}" TextWrapping="Wrap" />
                </StackPanel>
            </StackPanel>

            <!-- フッター -->
            <TextBlock Text="{Binding FooterText}" Style="{StaticResource SecondaryText}" HorizontalAlignment="Right" Margin="0,2,4,0">
                <TextBlock.ToolTip>
                    <ToolTip Content="クリックで詳細表示を切り替え・ドラッグで移動" />
                </TextBlock.ToolTip>
            </TextBlock>
        </StackPanel>
    </Border>
</Window>
