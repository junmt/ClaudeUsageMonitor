<Window x:Class="ClaudeUsageMonitor.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Claude Usage Monitor の設定"
        Icon="pack://application:,,,/Assets/app.ico"
        Width="520" Height="640" MinWidth="460" MinHeight="420"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResizeWithGrip"
        FontFamily="Segoe UI, Yu Gothic UI" FontSize="13">
    <Window.Resources>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,12" />
            <Setter Property="Padding" Value="8,6" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,4" />
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,4,12,4" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="Gray" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,2,0,4" />
        </Style>
    </Window.Resources>

    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="保存" Width="90" Padding="0,4" IsDefault="True" Click="OnSaveClick" Margin="0,0,8,0" />
            <Button Content="キャンセル" Width="90" Padding="0,4" IsCancel="True" />
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,8,0">
                <GroupBox Header="一般">
                    <StackPanel>
                        <CheckBox x:Name="AutoStartCheck" Content="Windows の起動時に自動起動する" />
                        <CheckBox x:Name="NotificationsCheck" Content="しきい値を超えたら通知する" />
                        <CheckBox x:Name="NotifyResetCheck" Content="利用枠がリセットされたら通知する" />
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="利用枠の取得">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Text="取得元" Style="{StaticResource Label}" />
                        <ComboBox x:Name="SourceCombo" Grid.Column="1" Margin="0,4">
                            <ComboBoxItem Content="自動（Windows → WSL の順に試す）" Tag="Auto" />
                            <ComboBoxItem Content="Windows のみ" Tag="WindowsOnly" />
                            <ComboBoxItem Content="WSL のみ" Tag="WslOnly" />
                        </ComboBox>

                        <TextBlock Grid.Row="1" Text="取得間隔（分）" Style="{StaticResource Label}" />
                        <TextBox x:Name="IntervalBox" Grid.Row="1" Grid.Column="1" Width="60" HorizontalAlignment="Left" Margin="0,4" />

                        <TextBlock Grid.Row="2" Text="Claude Code のパス" Style="{StaticResource Label}" />
                        <DockPanel Grid.Row="2" Grid.Column="1" Margin="0,4">
                            <Button DockPanel.Dock="Right" Content="参照..." Padding="8,0" Margin="6,0,0,0" Click="OnBrowseClick" />
                            <TextBox x:Name="ClaudePathBox" />
                        </DockPanel>

                        <TextBlock x:Name="DetectionText" Grid.Row="3" Grid.ColumnSpan="2" Style="{StaticResource Hint}" />
                    </Grid>
                </GroupBox>

                <GroupBox Header="ローカルログの集計">
                    <StackPanel>
                        <TextBlock Text="監視する WSL ディストリビューション" Margin="0,2,0,2" />
                        <StackPanel x:Name="WslPanel" Margin="8,0,0,4" />
                        <CheckBox x:Name="StartStoppedWslCheck" Content="ログを読むために停止中の WSL を起動する" />
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="オフの場合、停止中のディストリビューションのログは次に起動したときに読み込みます。利用枠の取得では、この設定に関わらず必要に応じて起動します。" />
                        <TextBlock Text="追加の監視ディレクトリ（1行に1つ）" Margin="0,8,0,2" />
                        <TextBox x:Name="ExtraDirsBox" AcceptsReturn="True" Height="60" VerticalScrollBarVisibility="Auto" />
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="表示">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Text="警告 / 危険しきい値（%）" Style="{StaticResource Label}" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,4">
                            <TextBox x:Name="WarningBox" Width="50" />
                            <TextBlock Text=" / " VerticalAlignment="Center" />
                            <TextBox x:Name="CriticalBox" Width="50" />
                        </StackPanel>

                        <TextBlock Grid.Row="1" Text="テーマ" Style="{StaticResource Label}" />
                        <ComboBox x:Name="ThemeCombo" Grid.Row="1" Grid.Column="1" Width="180" HorizontalAlignment="Left" Margin="0,4">
                            <ComboBoxItem Content="システム設定に従う" Tag="System" />
                            <ComboBoxItem Content="ライト" Tag="Light" />
                            <ComboBoxItem Content="ダーク" Tag="Dark" />
                        </ComboBox>

                        <TextBlock Grid.Row="2" Text="重ね順" Style="{StaticResource Label}" />
                        <ComboBox x:Name="TopmostCombo" Grid.Row="2" Grid.Column="1" Width="180" HorizontalAlignment="Left" Margin="0,4">
                            <ComboBoxItem Content="常に最前面" Tag="AlwaysOnTop" />
                            <ComboBoxItem Content="通常" Tag="Normal" />
                            <ComboBoxItem Content="デスクトップに固定（最背面）" Tag="Bottom" />
                        </ComboBox>

                        <TextBlock Grid.Row="3" Text="不透明度" Style="{StaticResource Label}" />
                        <DockPanel Grid.Row="3" Grid.Column="1" Margin="0,4">
                            <TextBlock DockPanel.Dock="Right" Width="40" TextAlignment="Right" VerticalAlignment="Center"
                                       Text="{Binding Value, ElementName=OpacitySlider, StringFormat={}{0:0}%}" />
                            <Slider x:Name="OpacitySlider" Minimum="30" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True" />
                        </DockPanel>

                        <CheckBox x:Name="ShowEmailCheck" Grid.Row="4" Grid.ColumnSpan="2" Content="メールアドレスを表示する" />
                    </Grid>
                </GroupBox>

                <GroupBox Header="システム情報（オプション）">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="70" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="PC" Style="{StaticResource Label}" />
                            <CheckBox x:Name="ShowPcCpuCheck" Grid.Column="1" Content="CPU" />
                            <CheckBox x:Name="ShowPcMemoryCheck" Grid.Column="2" Content="メモリ" />
                            <CheckBox x:Name="ShowPcStorageCheck" Grid.Column="3" Content="ストレージ" />
                            <TextBlock Grid.Row="1" Text="WSL2" Style="{StaticResource Label}" />
                            <CheckBox x:Name="ShowWslCpuCheck" Grid.Row="1" Grid.Column="1" Content="CPU" />
                            <CheckBox x:Name="ShowWslMemoryCheck" Grid.Row="1" Grid.Column="2" Content="メモリ" />
                            <CheckBox x:Name="ShowWslStorageCheck" Grid.Row="1" Grid.Column="3" Content="ストレージ" />
                        </Grid>
                        <DockPanel Margin="0,6,0,0">
                            <TextBlock Text="表示するドライブ" Style="{StaticResource Label}" />
                            <TextBox x:Name="StorageDrivesBox" ToolTip="例: C:, D:" />
                        </DockPanel>
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="ドライブを空欄にすると NTFS / ReFS の固定ドライブをすべて表示します（Google ドライブなどの仮想ドライブは除外）。WSL2 は 30 秒ごとに VM 内の CPU 使用率・メモリ・ルートファイルシステム（/）を取得し、メモリは Windows 上で VM が使用している量も表示します。WSL が停止中のときは起動しません。" />
                    </StackPanel>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
