<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="WidgetBackgroundBrush" Color="#F7F7F5" />
    <SolidColorBrush x:Key="WidgetBorderBrush" Color="#D9D9D6" />
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#1F1F1F" />
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#6B6B6B" />
    <SolidColorBrush x:Key="SectionTextBrush" Color="#7A7A7A" />
    <SolidColorBrush x:Key="TrackBrush" Color="#E2E2DF" />
    <SolidColorBrush x:Key="NormalBrush" Color="#6E6E6E" />
    <SolidColorBrush x:Key="WarningBrush" Color="#C98A00" />
    <SolidColorBrush x:Key="CriticalBrush" Color="#C9372C" />
    <SolidColorBrush x:Key="StaleBrush" Color="#BDBDBD" />
    <SolidColorBrush x:Key="AccentBrush" Color="#C15F3C" />
    <SolidColorBrush x:Key="ButtonHoverBrush" Color="#E8E8E5" />
    <SolidColorBrush x:Key="ErrorBackgroundBrush" Color="#FBE3E1" />
</ResourceDictionary>
