<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="WidgetBackgroundBrush" Color="#2B2B2B" />
    <SolidColorBrush x:Key="WidgetBorderBrush" Color="#3D3D3D" />
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#E6E6E6" />
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#9A9A9A" />
    <SolidColorBrush x:Key="SectionTextBrush" Color="#8A8A8A" />
    <SolidColorBrush x:Key="TrackBrush" Color="#3A3A3A" />
    <SolidColorBrush x:Key="NormalBrush" Color="#B8B8B8" />
    <SolidColorBrush x:Key="WarningBrush" Color="#E5B33A" />
    <SolidColorBrush x:Key="CriticalBrush" Color="#E5534B" />
    <SolidColorBrush x:Key="StaleBrush" Color="#5E5E5E" />
    <SolidColorBrush x:Key="AccentBrush" Color="#D97757" />
    <SolidColorBrush x:Key="ButtonHoverBrush" Color="#3F3F3F" />
    <SolidColorBrush x:Key="ErrorBackgroundBrush" Color="#4A2A28" />
</ResourceDictionary>
